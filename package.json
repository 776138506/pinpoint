{
  "name": "dsh-point",
  "version": "0.1.0",
  "description": "Pinpoint：指哪打哪的 dsh 沟通插件——浏览器扩展在任意网页标记元素并评论，截图+结构化文本直达 dsh 会话。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs && node extension/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run"
  },
  "dependencies": {
    "html2canvas": "^1.4.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.6",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.2.18",
    "esbuild": "^0.28.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vitest": "^3.0.0"
  }
}
